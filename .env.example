# tabs — settings of the server (start.bat / npm start reads this file)
# without the HAVOC_* lines tabs runs open, like the laptop in the rehearsal room

# start.bat (jam: tabs, beats and time on one machine) sets the port and the path itself — the router
# answers on 3000, tabs behind it on 3001 at /tabs. PORT and BASE_PATH only matter for tabs alone (npm start).
PORT=3000
BASE_PATH=
# the port nginx proxy manager talks to under start.bat (default 3000; the apps take the next three)
JAM_PORT=

# tabs by mo-tion — leave TABS_BRAND empty. ("jam" would give the server its own name and look;
# changing it needs a new build — start.bat does that by itself)
TABS_BRAND=

# every session code starts with this — tabs.mo-tion.at sends codes like lg7k2m9q (and links to them) here
TABS_ROOM_PREFIX=lg
# the shows in example/ land in the library once, as shared shows (0 = don't)
TABS_SEED_SHOWS=1

# the public address of this server — invite links and the sign-in callback
APP_URL=https://jam.geyser.at/tabs

# ---- sign in with havoc -------------------------------------------------------
# from havoc: on any machine with hc (not the NUC — e.g. the dev pc, Havoc\cmd\hc.cmd):
#   hc login https://havoc.geyser.at
#   hc setup havoc.app.json --url https://jam.geyser.at/tabs --print-env
# and copy the printed lines in here
HAVOC_URL=https://havoc.geyser.at
HAVOC_CLIENT_ID=
HAVOC_CLIENT_SECRET=
# seals the sign-in cookie — leave it empty: the server makes one itself (data/secrets.json)
SESSION_SECRET=
# how this server reaches havoc itself, if havoc.geyser.at doesn't resolve inside the lan
# (no nat loopback) — e.g. http://192.168.88.15:8000
HAVOC_INTERNAL_URL=

# lowest havoc project role that may start sessions, keep a library and build shows
# viewer · contributor · editor · admin (admins: host in every session, everyone's library)
TABS_HOST_ROLE=contributor
# members of this havoc group count as admins too (optional)
TABS_ADMIN_GROUP=

# ---- library -------------------------------------------------------------------
# where tabs and shows are kept on disk
TABS_DATA=data

# ---- control api (mo-tion time, scripts, stream deck) -----------------------------
# the key every control request needs (header X-Tabs-Key or ?key=) — leave it empty: the server
# makes one itself (data/secrets.json); admins see it on /control, in every cue they copy
TABS_CONTROL_KEY=
# browser origins allowed to call it (mo-tion time runs in a browser); * = any
TABS_CONTROL_ORIGINS=*

# ---- mo-tion beats -----------------------------------------------------------------
# where beats lives — "edit in beats" on the groove desk (optional)
BEATS_URL=https://jam.geyser.at/beats

# proxies whose X-Forwarded-* headers count: the router on this machine and nginx proxy manager in the lan
TRUST_PROXY=loopback, uniquelocal
